  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.7",
    "baseline-browser-mapping": "^2.10.42",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  }
}
